# HalalSaver MY — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Firebase Web API Key ──────────────────────────────────────────────────────
# Found in: Firebase Console → Project Settings → General → Web API Key
FIREBASE_WEB_API_KEY=your-web-api-key-here

# ── Firebase Realtime Database URL (optional) ─────────────────────────────────
# Default is auto-derived from project_id in serviceAccountKey.json.
# Override here only if your project uses a non-default database name.
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ── Flask Secret Key (change in production) ───────────────────────────────────
# FLASK_SECRET_KEY=change-me-in-production
